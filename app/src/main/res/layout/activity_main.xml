<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF"
    android:paddingStart="16dp"
    android:paddingEnd="16dp">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="14dp"
            android:paddingBottom="12dp">

            <!-- INFORMASI AKUN -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvNamaAkun"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Atifah"
                        android:textColor="#222222"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvEmailAkun"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="atifah@gmail.com"
                        android:textColor="#888888"
                        android:textSize="11sp" />

                </LinearLayout>

            </LinearLayout>
            <!-- SAPAAN -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Halo, Selamat Datang!"
                android:textColor="#555555"
                android:textSize="12sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Jelajahi Wisata Bandung"
                android:textColor="#222222"
                android:textSize="17sp"
                android:textStyle="bold" />

            <!-- PENCARIAN -->
            <EditText
                android:id="@+id/etSearch"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_search"
                android:drawableStart="@android:drawable/ic_menu_search"
                android:drawablePadding="8dp"
                android:hint="Cari tempat wisata..."
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:singleLine="true"
                android:textColor="#333333"
                android:textColorHint="#888888"
                android:textSize="11sp" />

            <!-- KATEGORI -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnSemua"
                    style="@style/CategoryButton"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_chip_active"
                    android:text="Semua"
                    android:textColor="#FFFFFF" />

                <TextView
                    android:id="@+id/btnAlam"
                    style="@style/CategoryButton"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:text="Alam" />

                <TextView
                    android:id="@+id/btnBudaya"
                    style="@style/CategoryButton"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:text="Budaya" />

                <TextView
                    android:id="@+id/btnKuliner"
                    style="@style/CategoryButton"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:text="Kuliner" />
            </LinearLayout>

            <!-- JUDUL DAFTAR -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="10dp"
                android:text="Rekomendasi Untukmu"
                android:textColor="#222222"
                android:textSize="13sp"
                android:textStyle="bold" />

            <!-- KARTU BRAGA -->
            <LinearLayout
                android:id="@+id/cardBraga"
                style="@style/TourismCard"
                android:tag="Budaya"
                android:contentDescription="Braga">

                <TextView
                    style="@style/TourismImage"
                    android:text="🏛️" />

                <LinearLayout style="@style/TourismInfo">

                    <TextView
                        style="@style/TourismName"
                        android:text="Braga" />

                    <TextView
                        style="@style/TourismDescription"
                        android:text="📍 Bandung, Indonesia" />

                    <TextView
                        style="@style/TourismDescription"
                        android:text="⭐ 4,9" />
                </LinearLayout>

                <TextView
                    style="@style/ArrowText"
                    android:text="›" />
            </LinearLayout>

            <!-- KARTU KAWAH PUTIH -->
            <LinearLayout
                android:id="@+id/cardKawah"
                style="@style/TourismCard"
                android:tag="Alam"
                android:contentDescription="Kawah Putih">

                <TextView
                    style="@style/TourismImage"
                    android:text="🏞️" />

                <LinearLayout style="@style/TourismInfo">

                    <TextView
                        style="@style/TourismName"
                        android:text="Kawah Putih" />

                    <TextView
                        style="@style/TourismDescription"
                        android:text="📍 Ciwidey, Indonesia" />

                    <TextView
                        style="@style/TourismDescription"
                        android:text="⭐ 4,7" />
                </LinearLayout>

                <TextView
                    style="@style/ArrowText"
                    android:text="›" />
            </LinearLayout>

            <!-- KARTU LEMBANG PARK & ZOO -->
            <LinearLayout
                android:id="@+id/cardLembang"
                style="@style/TourismCard"
                android:tag="Alam"
                android:contentDescription="Lembang Park &amp; Zoo">

                <TextView
                    style="@style/TourismImage"
                    android:text="🦩" />

                <LinearLayout style="@style/TourismInfo">

                    <TextView
                        style="@style/TourismName"
                        android:text="Lembang Park &amp; Zoo" />

                    <TextView
                        style="@style/TourismDescription"
                        android:text="📍 Lembang, Indonesia" />

                    <TextView
                        style="@style/TourismDescription"
                        android:text="⭐ 4,6" />
                </LinearLayout>

                <TextView
                    style="@style/ArrowText"
                    android:text="›" />
            </LinearLayout>

            <!-- KARTU DUSUN BAMBU -->
            <LinearLayout
                android:id="@+id/cardDusun"
                style="@style/TourismCard"
                android:tag="Alam"
                android:contentDescription="Dusun Bambu Lembang">

                <TextView
                    style="@style/TourismImage"
                    android:text="🌳" />

                <LinearLayout style="@style/TourismInfo">

                    <TextView
                        style="@style/TourismName"
                        android:text="Dusun Bambu Lembang" />

                    <TextView
                        style="@style/TourismDescription"
                        android:text="📍 Bandung Barat" />

                    <TextView
                        style="@style/TourismDescription"
                        android:text="⭐ 4,5" />
                </LinearLayout>

                <TextView
                    style="@style/ArrowText"
                    android:text="›" />
            </LinearLayout>

            <!-- KARTU DAGO -->
            <LinearLayout
                android:id="@+id/cardDago"
                style="@style/TourismCard"
                android:tag="Alam"
                android:contentDescription="Dago Dream Park">

                <TextView
                    style="@style/TourismImage"
                    android:text="🎡" />

                <LinearLayout style="@style/TourismInfo">

                    <TextView
                        style="@style/TourismName"
                        android:text="Dago Dream Park" />

                    <TextView
                        style="@style/TourismDescription"
                        android:text="📍 Lembang, Indonesia" />

                    <TextView
                        style="@style/TourismDescription"
                        android:text="⭐ 4,5" />
                </LinearLayout>

                <TextView
                    style="@style/ArrowText"
                    android:text="›" />
            </LinearLayout>

            <!-- KARTU SAUNG ANGKLUNG UDJO -->
            <LinearLayout
                android:id="@+id/cardAngklung"
                style="@style/TourismCard"
                android:tag="Budaya"
                android:contentDescription="Saung Angklung Udjo">

                <TextView
                    style="@style/TourismImage"
                    android:text="🎭" />

                <LinearLayout style="@style/TourismInfo">

                    <TextView
                        style="@style/TourismName"
                        android:text="Saung Angklung Udjo" />

                    <TextView
                        style="@style/TourismDescription"
                        android:text="📍 Padasuka, Bandung" />

                    <TextView
                        style="@style/TourismDescription"
                        android:text="⭐ 4,7" />
                </LinearLayout>

                <TextView
                    style="@style/ArrowText"
                    android:text="›" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- NAVIGASI BAWAH -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:background="@drawable/bg_bottom_nav"
        android:gravity="center"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/navHome"
            style="@style/NavigationItem"
            android:text="⌂"
            android:textColor="#2563EB" />

        <TextView
            android:id="@+id/navCari"
            style="@style/NavigationItem"
            android:text="⌕" />

        <TextView
            android:id="@+id/navFavorit"
            style="@style/NavigationItem"
            android:text="♡" />

        <TextView
            android:id="@+id/navProfil"
            style="@style/NavigationItem"
            android:text="♙" />

    </LinearLayout>

</LinearLayout>